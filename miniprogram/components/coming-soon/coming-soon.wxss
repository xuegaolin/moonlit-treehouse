.soon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.moon {
  font-size: 60rpx;
  opacity: 0.6;
}

.icon {
  font-size: 120rpx;
  margin-top: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #E8E6F5;
  margin-top: 36rpx;
}

.badge {
  margin-top: 20rpx;
  background: rgba(245, 215, 110, 0.15);
  color: #F5D76E;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(245, 215, 110, 0.4);
}

.desc {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #9C97B8;
  text-align: center;
  line-height: 1.8;
}

.eta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6B5CE7;
}

.btn {
  width: 100%;
  margin-top: 32rpx;
}
