.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: linear-gradient(180deg, #2A2450 0%, #1F1C33 40%);
}

.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 20rpx;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.logo {
  font-size: 64rpx;
  margin-right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.app-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #E8E6F5;
}

.greeting {
  font-size: 24rpx;
  color: #9C97B8;
  margin-top: 4rpx;
}

.msg-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.slogan {
  text-align: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #3D3663 0%, #2A2450 100%);
  border: 1rpx solid rgba(245, 215, 110, 0.2);
}

.slogan-line {
  font-size: 32rpx;
  color: #F5D76E;
  line-height: 1.9;
  letter-spacing: 2rpx;
}

.section-title {
  font-size: 26rpx;
  color: #9C97B8;
  margin: 36rpx 32rpx 8rpx;
}

.social-section {
  margin: 0 32rpx 24rpx;
  padding: 0;
}

.social-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #2A2450;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.social-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.social-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.social-title {
  font-size: 28rpx;
  color: #E8E6F5;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.social-desc {
  font-size: 22rpx;
  color: #9C97B8;
}

.social-arrow {
  font-size: 36rpx;
  color: #6E6899;
}

.social-empty {
  padding: 32rpx 24rpx;
  background: rgba(107, 92, 231, 0.1);
  border-radius: 16rpx;
  text-align: center;
}

.social-empty text {
  font-size: 24rpx;
  color: #B9B3E8;
  line-height: 1.6;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  margin-top: 60rpx;
}

.checkin {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 28rpx 20rpx;
}

.checkin-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.checkin-info {
  flex: 1;
}

.checkin-title {
  font-size: 30rpx;
  color: #F5F3FF;
  font-weight: 600;
}

.checkin-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.checkin-btn {
  min-width: 132rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #2A2450;
  font-weight: 600;
  background: linear-gradient(135deg, #FFE9A8 0%, #FFC96B 100%);
}

.checkin-btn-done {
  color: #9C97C4;
  background: rgba(255, 255, 255, 0.10);
}

.checkin-cal {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 24rpx;
}

.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.cal-dot {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  line-height: 1.2;
}

.cal-cell-on .cal-dot {
  color: #FFC96B;
}

.cal-label {
  font-size: 20rpx;
  color: #8B86B0;
  margin-top: 6rpx;
}

.cal-cell-today .cal-label {
  color: #F5F3FF;
  font-weight: 600;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 13, 30, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.result-card {
  width: 560rpx;
  padding: 48rpx 40rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #3A3468 0%, #272343 100%);
  text-align: center;
}

.result-icon {
  font-size: 72rpx;
  line-height: 1;
}

.result-streak {
  margin-top: 18rpx;
  font-size: 40rpx;
  color: #FFC96B;
  font-weight: 700;
}

.result-encourage {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #E8E5FF;
  line-height: 1.6;
}

.result-coin {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #FFE9A8;
}

.result-medals {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 201, 107, 0.12);
}

.result-medals-title {
  font-size: 24rpx;
  color: #FFC96B;
}

.result-medal {
  margin-top: 10rpx;
  font-size: 30rpx;
  color: #F5F3FF;
  font-weight: 600;
}

.result-next {
  margin-top: 24rpx;
  font-size: 22rpx;
}

.result-close {
  margin-top: 28rpx;
  padding: 18rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #2A2450;
  font-weight: 600;
  background: linear-gradient(135deg, #FFE9A8 0%, #FFC96B 100%);
}
