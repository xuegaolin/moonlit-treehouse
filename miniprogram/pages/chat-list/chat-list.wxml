<view class="page">
    <view class="header">
        <text class="header-title">消息</text>
        <view class="header-btn" bindtap="goFriends">
            <text class="header-btn-icon">👥</text>
        </view>
    </view>

    <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
    </view>

    <view wx:elif="{{!hasSessions}}" class="empty">
        <text class="empty-icon">💬</text>
        <text class="empty-text">暂无消息</text>
        <text class="empty-hint">去漂流墙或好友列表发起聊天吧~</text>
    </view>

    <view wx:else class="session-list">
        <view
            wx:for="{{sessions}}"
            wx:key="peerUserId"
            class="session-item"
            bindtap="goChat"
            data-session="{{item}}"
        >
            <view class="session-avatar">
                <text class="avatar-text">{{item.peerNickname ? item.peerNickname.charAt(0) : '匿'}}</text>
            </view>
            <view class="session-info">
                <view class="session-top">
                    <text class="session-name">{{item.peerNickname || '匿名用户'}}</text>
                    <text wx:if="{{item.unread > 0}}" class="session-badge">{{item.unread > 99 ? '99+' : item.unread}}</text>
                </view>
                <view class="session-bottom">
                    <text class="session-preview">{{item.lastMsgPreview || '暂无消息'}}</text>
                    <text class="session-time">{{item.lastMsgAt || ''}}</text>
                </view>
            </view>
        </view>
    </view>
</view>
