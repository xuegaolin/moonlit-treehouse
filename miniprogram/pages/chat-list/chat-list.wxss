.page {
    min-height: 100vh;
    background-color: #1F1C33;
    padding-bottom: 40rpx;
}

.header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 30rpx 32rpx 20rpx;
    background: linear-gradient(180deg, #6B5CE7 0%, #5B4CD8 100%);
}

.header-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #FFFFFF;
}

.header-btn {
    width: 64rpx;
    height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
}

.header-btn-icon {
    font-size: 32rpx;
}

.loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120rpx 0;
    color: #9C97B8;
    font-size: 28rpx;
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 160rpx 60rpx;
}

.empty-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
    opacity: 0.6;
}

.empty-text {
    font-size: 32rpx;
    color: #E8E6F5;
    margin-bottom: 16rpx;
}

.empty-hint {
    font-size: 24rpx;
    color: #9C97B8;
    text-align: center;
}

.session-list {
    padding: 20rpx 0;
}

.session-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx 32rpx;
    background: #2A2450;
    margin-bottom: 2rpx;
    transition: background 0.2s;
}

.session-item:active {
    background: #322B5C;
}

.session-avatar {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #6B5CE7 0%, #8B7CF7 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 24rpx;
    flex-shrink: 0;
}

.avatar-text {
    font-size: 40rpx;
    color: #FFFFFF;
    font-weight: 500;
}

.session-info {
    flex: 1;
    min-width: 0;
}

.session-top {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12rpx;
}

.session-name {
    font-size: 30rpx;
    color: #E8E6F5;
    font-weight: 500;
}

.session-badge {
    min-width: 36rpx;
    height: 36rpx;
    line-height: 36rpx;
    padding: 0 10rpx;
    background: #F5D76E;
    border-radius: 18rpx;
    font-size: 20rpx;
    color: #2A2450;
    text-align: center;
    font-weight: 600;
}

.session-bottom {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.session-preview {
    font-size: 26rpx;
    color: #9C97B8;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 16rpx;
}

.session-time {
    font-size: 22rpx;
    color: #6E6899;
    flex-shrink: 0;
}
