.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: linear-gradient(180deg, #2A2450 0%, #1F1C33 40%);
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 0;
}

.streak-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #F5D76E;
}

.streak-label {
  font-size: 24rpx;
  color: #9C97B8;
}

.hero {
  text-align: center;
  padding: 56rpx 32rpx;
}

.hero-icon {
  font-size: 110rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #F5D76E;
  margin-top: 24rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #9C97B8;
  margin-top: 12rpx;
}

.section {
  margin: 12rpx 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #9C97B8;
  margin-bottom: 16rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.chip {
  background: #2A2450;
  color: #B9B3E8;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  border: 1rpx solid transparent;
}

.chip-active {
  background: rgba(107, 92, 231, 0.25);
  color: #ffffff;
  border-color: #6B5CE7;
}

.chip-lock {
  opacity: 0.6;
}

.nickname-input {
  background: #2A2450;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  color: #E8E6F5;
  font-size: 28rpx;
}

.input-ph {
  color: #6E6899;
}

.claim-area {
  margin: 48rpx 32rpx 0;
}

.claim-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  /* 深紫下加重月黄。避免明亮到刺眼 */
  background: linear-gradient(135deg, #6B5CE7 0%, #5A4DC8 100%);
  box-shadow: 0 4rpx 16rpx rgba(107, 92, 231, 0.35);
  transition: transform 0.15s ease, opacity 0.2s ease;
}

/* 点击时：轻降透明度 + 轻下压。不闪白光 */
.claim-btn-hover {
  opacity: 0.85;
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(107, 92, 231, 0.4);
}

.claim-btn-loading {
  opacity: 0.6;
  pointer-events: none;
}

.claim-btn-spinner {
  font-size: 32rpx;
  margin-right: 12rpx;
  animation: spin 1.2s linear infinite;
  display: inline-block;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.claim-tip {
  text-align: center;
  font-size: 22rpx;
  margin-top: 16rpx;
}

.cert-area {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 8rpx;
}

.cert-canvas {
  width: 630rpx;
  height: 840rpx;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
}

.actions {
  display: flex;
  flex-direction: row;
  margin: 32rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 12rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.action-btn[hover-class] {
  /* 避免原生 button 默认闪白 */
}

.btn-primary-hover {
  opacity: 0.85;
  transform: translateY(1rpx);
}

.btn-ghost-hover {
  background: rgba(107, 92, 231, 0.1);
}

.btn-ghost-share {
  /* 保留 <button> 以支持 open-type="share"，但重置默认边框 */
  border: none;
  padding: 0;
  margin: 0 12rpx;
  font-weight: 400;
}

.btn-ghost-share::after {
  border: none;
}

.share-tip {
  text-align: center;
  font-size: 22rpx;
}

.history {
  margin: 48rpx 32rpx 0;
}

.history-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  color: #B9B3E8;
  font-size: 28rpx;
  padding: 24rpx 8rpx;
}

.history-toggle {
  color: #6B5CE7;
  font-size: 24rpx;
}

.history-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: #2A2450;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.history-no {
  font-size: 26rpx;
  color: #F5D76E;
}

.history-reason {
  font-size: 22rpx;
  color: #9C97B8;
  margin-top: 8rpx;
  max-width: 520rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-view {
  color: #6B5CE7;
  font-size: 24rpx;
  flex-shrink: 0;
}
