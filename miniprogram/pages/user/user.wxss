.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: linear-gradient(180deg, #2A2450 0%, #1F1C33 40%);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E8E6F5;
}

/* 资料卡 */
.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
}

.avatar-ph {
  background: #3D3663;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.profile-meta {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #E8E6F5;
}

.input-ph {
  color: #6E6899;
}

.openid {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.member-tag {
  background: linear-gradient(135deg, #F5D76E, #E8B84B);
  color: #4A3F00;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

/* 月光币 */
.wallet-row {
  display: flex;
  flex-direction: row;
  margin-top: 28rpx;
}

.wallet-item {
  flex: 1;
  text-align: center;
}

.wallet-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #E8E6F5;
}

.wallet-label {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.earn-tip {
  font-size: 22rpx;
  margin-top: 24rpx;
  text-align: center;
}

/* 会员 */
.member-card {
  border: 1rpx solid rgba(245, 215, 110, 0.25);
}

.member-desc {
  font-size: 24rpx;
  margin-top: 10rpx;
}

.plans {
  display: flex;
  flex-direction: row;
  margin-top: 28rpx;
}

.plan {
  flex: 1;
  position: relative;
  background: #1F1C33;
  border: 1rpx solid #3D3663;
  border-radius: 20rpx;
  text-align: center;
  padding: 32rpx 0;
  margin-right: 14rpx;
}

.plan:last-child {
  margin-right: 0;
}

.plan-recommend {
  border-color: #F5D76E;
}

.plan-tag {
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #F5D76E;
  color: #4A3F00;
  font-size: 20rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
}

.plan-label {
  font-size: 26rpx;
  color: #B9B3E8;
}

.plan-price {
  color: #F5D76E;
  font-size: 28rpx;
  margin-top: 10rpx;
}

.plan-price-num {
  font-size: 40rpx;
  font-weight: 700;
}

.plan-days {
  font-size: 20rpx;
  margin-top: 6rpx;
}

/* 功能入口 */
.entries {
  padding: 8rpx 32rpx;
}

.entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0;
}

.entry-icon {
  font-size: 36rpx;
}

.entry-label {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #E8E6F5;
}

.entry-arrow {
  color: #6B5CE7;
  font-size: 36rpx;
}

.social-tip {
  text-align: center;
  font-size: 20rpx;
  margin: 30rpx 32rpx 0;
  padding: 16rpx 24rpx;
  background: rgba(107, 92, 231, 0.08);
  border-radius: 16rpx;
  line-height: 1.6;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  margin-top: 40rpx;
}
