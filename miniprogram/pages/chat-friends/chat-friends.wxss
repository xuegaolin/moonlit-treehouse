.page {
    min-height: 100vh;
    background-color: #1F1C33;
    padding-bottom: 40rpx;
}

.header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 30rpx 32rpx 20rpx;
    background: linear-gradient(180deg, #6B5CE7 0%, #5B4CD8 100%);
}

.header-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #FFFFFF;
}

.loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120rpx 0;
    color: #9C97B8;
    font-size: 28rpx;
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 160rpx 60rpx;
}

.empty-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
    opacity: 0.6;
}

.empty-text {
    font-size: 32rpx;
    color: #E8E6F5;
    margin-bottom: 16rpx;
}

.empty-hint {
    font-size: 24rpx;
    color: #9C97B8;
    text-align: center;
}

.friend-list {
    padding: 20rpx 0;
}

.friend-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx 32rpx;
    background: #2A2450;
    margin-bottom: 2rpx;
    transition: background 0.2s;
}

.friend-item:active {
    background: #322B5C;
}

.friend-avatar {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #6B5CE7 0%, #8B7CF7 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 24rpx;
    flex-shrink: 0;
}

.avatar-text {
    font-size: 40rpx;
    color: #FFFFFF;
    font-weight: 500;
}

.friend-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.friend-name {
    font-size: 30rpx;
    color: #E8E6F5;
    font-weight: 500;
    margin-bottom: 8rpx;
}

.friend-status {
    font-size: 24rpx;
    color: #9C97B8;
}

.friend-status-ok {
    color: #7AED9A;
}

.friend-arrow {
    font-size: 40rpx;
    color: #6E6899;
    flex-shrink: 0;
}
