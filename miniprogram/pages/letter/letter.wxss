.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: linear-gradient(180deg, #2A2450 0%, #1F1C33 40%);
}

/* ========== Tab 栏 ========== */
.tabbar {
  display: flex;
  flex-direction: row;
  background: #1F1C33;
  border-bottom: 1rpx solid #2A2450;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  color: #9C97B8;
  font-size: 26rpx;
  position: relative;
  transition: color 0.2s;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 24rpx;
}

.tab-active {
  color: #F5D76E;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #F5D76E;
  border-radius: 2rpx;
}

/* ========== 写信 Tab ========== */
.hero {
  text-align: center;
  padding: 48rpx 32rpx 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #F5D76E;
}

.hero-desc {
  font-size: 26rpx;
  color: #9C97B8;
  margin-top: 12rpx;
}

.section {
  margin: 24rpx 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #9C97B8;
  margin-bottom: 16rpx;
}

.row-between {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.counter {
  font-size: 22rpx;
}

/* 收信人列表 */
.receiver-list {
  display: flex;
  flex-direction: column;
}

.receiver {
  background: #2A2450;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.receiver-active {
  background: rgba(107, 92, 231, 0.18);
  border-color: #6B5CE7;
}

.receiver-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #E8E6F5;
}

.receiver-desc {
  font-size: 22rpx;
  margin-top: 6rpx;
}

/* 信封 chips */
.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.chip {
  background: #2A2450;
  color: #B9B3E8;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  border: 1rpx solid transparent;
  display: inline-flex;
  align-items: center;
}

.chip-emoji {
  margin-right: 8rpx;
}

.chip-active {
  background: rgba(107, 92, 231, 0.25);
  color: #ffffff;
  border-color: #6B5CE7;
}

/* 正文 */
.content-area {
  width: 100%;
  min-height: 320rpx;
  background: #2A2450;
  border-radius: 20rpx;
  padding: 28rpx;
  color: #E8E6F5;
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.input-ph {
  color: #6E6899;
}

/* 送达时间 */
.deliver-preview {
  font-size: 24rpx;
  margin-top: 12rpx;
  text-align: center;
}

/* AI */
.ai-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: #2A2450;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.ai-label {
  font-size: 28rpx;
  color: #E8E6F5;
  display: flex;
  align-items: center;
}

.ai-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

/* 提交 */
.submit-area {
  margin: 48rpx 32rpx 0;
}

.submit-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
}

.submit-tip {
  text-align: center;
  font-size: 22rpx;
  margin-top: 16rpx;
}

/* ========== 信箱 Tab ========== */
.filters {
  display: flex;
  flex-direction: row;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #2A2450;
}

.filter {
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #9C97B8;
  background: #2A2450;
  border-radius: 999rpx;
}

.filter-active {
  background: #6B5CE7;
  color: #ffffff;
}

.loading,
.empty {
  text-align: center;
  padding: 100rpx 0;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  color: #E8E6F5;
  margin-top: 20rpx;
  font-weight: 600;
}

.empty-desc {
  font-size: 24rpx;
  margin-top: 12rpx;
}

.letter-list {
  padding: 16rpx 24rpx;
}

.letter-item {
  background: #2A2450;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.letter-item:active {
  background: #3D3663;
}

.letter-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.letter-envelope {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.letter-meta {
  flex: 1;
}

.letter-id {
  font-size: 24rpx;
  color: #F5D76E;
  font-family: monospace;
}

.letter-receiver {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.status-pending {
  background: rgba(245, 215, 110, 0.15);
  color: #F5D76E;
  border: 1rpx solid rgba(245, 215, 110, 0.3);
}

.status-delivered,
.status-replied {
  background: rgba(107, 92, 231, 0.18);
  color: #B9B3E8;
  border: 1rpx solid rgba(107, 92, 231, 0.3);
}

.status-canceled {
  background: rgba(156, 151, 184, 0.15);
  color: #6E6899;
  border: 1rpx solid rgba(156, 151, 184, 0.2);
}

.letter-summary {
  font-size: 26rpx;
  color: #D8D4F0;
  margin-top: 16rpx;
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.letter-foot {
  font-size: 22rpx;
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  padding: 20rpx 0;
}

.sub-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6B5CE7 0%, #8B7FE8 100%);
  margin: 16rpx 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(107, 92, 231, 0.3);
}

.sub-banner-emoji {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.sub-banner-text {
  flex: 1;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1.5;
}

.sub-banner-num {
  font-weight: 700;
  color: #FFC96B;
  margin: 0 4rpx;
}
