.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: linear-gradient(180deg, #2A2450 0%, #1F1C33 40%);
}

/* ====== Tab ====== */
.tabbar {
  display: flex;
  flex-direction: row;
  background: #1F1C33;
  border-bottom: 1rpx solid #2A2450;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #9C97B8;
  position: relative;
}

.tab-emoji {
  display: block;
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 24rpx;
}

.tab-active {
  color: #F5D76E;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #F5D76E;
  border-radius: 2rpx;
}

/* ====== 信息流 ====== */
.sort-row {
  display: flex;
  flex-direction: row;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(42, 36, 80, 0.5);
}

.sort-btn {
  font-size: 24rpx;
  color: #9C97B8;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #2A2450;
}

.sort-active {
  background: #6B5CE7;
  color: #ffffff;
}

.loading,
.empty {
  text-align: center;
  padding: 100rpx 0;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  color: #E8E6F5;
  margin-top: 20rpx;
  font-weight: 600;
}

.empty-desc {
  font-size: 24rpx;
  margin-top: 12rpx;
}

.bottle-list {
  padding: 16rpx 24rpx;
}

.bottle {
  background: #2A2450;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.bottle-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.bottle-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #3D3663;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.bottle-meta {
  flex: 1;
  margin-left: 16rpx;
}

.bottle-anonymous {
  font-size: 26rpx;
  color: #F5D76E;
  font-weight: 600;
}

.bottle-time {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.bottle-content {
  font-size: 28rpx;
  color: #E8E6F5;
  line-height: 1.7;
  margin-top: 20rpx;
}

.bottle-tags {
  margin-top: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #B9B3E8;
  background: rgba(107, 92, 231, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
}

.bottle-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(245, 215, 110, 0.1);
}

.warm-stat {
  font-size: 22rpx;
}

.warm-btn {
  font-size: 26rpx;
  color: #6B5CE7;
  font-weight: 500;
}

/* ====== 发布 ====== */
.section-title {
  font-size: 26rpx;
  color: #9C97B8;
}

.bottle-area {
  width: 100%;
  min-height: 200rpx;
  background: #1F1C33;
  border-radius: 16rpx;
  padding: 24rpx;
  color: #E8E6F5;
  font-size: 28rpx;
  line-height: 1.7;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.input-ph {
  color: #6E6899;
}

.tag-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.tag-chip {
  background: #2A2450;
  color: #B9B3E8;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
  border: 1rpx solid transparent;
}

.tag-chip-active {
  background: rgba(107, 92, 231, 0.25);
  color: #ffffff;
  border-color: #6B5CE7;
}

.submit-area {
  margin: 36rpx 32rpx 0;
}

.submit-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
}

/* ====== 温暖弹层 ====== */
.warm-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.warm-panel {
  width: 100%;
  background: #2A2450;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
}

.warm-title {
  text-align: center;
  font-size: 30rpx;
  color: #F5D76E;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.warm-gifts {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

.warm-gift {
  background: #1F1C33;
  border-radius: 20rpx;
  padding: 28rpx 0;
  width: 30%;
  text-align: center;
  border: 2rpx solid transparent;
}

.warm-gift:active {
  border-color: #6B5CE7;
}

.warm-emoji {
  font-size: 70rpx;
  margin-bottom: 8rpx;
}

.warm-label {
  font-size: 26rpx;
  color: #E8E6F5;
  font-weight: 600;
}

.warm-cost {
  font-size: 20rpx;
  margin-top: 6rpx;
}

.warm-cancel {
  margin-top: 32rpx;
  text-align: center;
  color: #9C97B8;
  font-size: 28rpx;
  padding: 24rpx 0;
}

/* ===== 温暖按钮三态 ===== */
/* 自己的瓶子：置灰不可点，文案直接说明是"你的心事" */
.warm-btn-disabled {
  opacity: 0.45;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.5);
}

/* 已温暖过：金色已完成态 */
.warm-btn-done {
  background: rgba(255, 209, 102, 0.16);
  color: #FFD166;
}
