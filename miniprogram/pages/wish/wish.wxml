<view class="page">

  <!-- Tab 栏 -->
  <view class="tabbar">
    <view class="tab {{activeTab === 'mokugyo' ? 'tab-active' : ''}}" data-tab="mokugyo" bindtap="switchTab">
      <text class="tab-emoji">🪵</text>
      <text class="tab-label">电子木鱼</text>
    </view>
    <view class="tab {{activeTab === 'pool' ? 'tab-active' : ''}}" data-tab="pool" bindtap="switchTab">
      <text class="tab-emoji">🕯</text>
      <text class="tab-label">许愿池</text>
    </view>
  </view>

  <!-- ============== 木鱼 Tab ============== -->
  <block wx:if="{{activeTab === 'mokugyo'}}">
    <view class="hero">
      <view class="hero-title">每敲一下，功德 +1</view>
      <view class="hero-desc text-muted">今日剩余 {{todayLeft}} 次</view>
    </view>

    <!-- 木鱼区 -->
    <view class="mokugyo-area">
      <!-- 浮动 +1 反馈 -->
      <view wx:if="{{tapAnimating}}" class="plus-one">+1</view>

      <!-- 木鱼本体（点击区） -->
      <view class="mokugyo-btn" bindtap="onTap" hover-class="mokugyo-btn-hover">
        <view class="mokugyo-emoji">🪵</view>
        <view class="mokugyo-text">点击敲击</view>
      </view>
    </view>

    <view class="merit-card card">
      <view class="merit-row">
        <view class="merit-item">
          <view class="merit-num text-gold">{{merit}}</view>
          <view class="merit-label text-muted">累计功德</view>
        </view>
        <view class="merit-divider"></view>
        <view class="merit-item">
          <view class="merit-num">{{todayLeft}}/{{todayMax}}</view>
          <view class="merit-label text-muted">今日剩余</view>
        </view>
      </view>
      <view class="merit-tip text-muted">每 10 次 = +1 月光币 · 满了明天再来</view>
    </view>

    <view class="footer text-muted">今晚的焦虑，让木鱼替你消化 🪵</view>
  </block>

  <!-- ============== 许愿池 Tab ============== -->
  <block wx:else>
    <!-- 许愿表单 -->
    <view class="card">
      <view class="section-title">分类</view>
      <view class="chips">
        <view
          wx:for="{{categories}}"
          wx:key="code"
          class="chip {{selectedCategory === item.code ? 'chip-active' : ''}}"
          data-code="{{item.code}}"
          bindtap="onSelectCategory"
        >
          <text>{{item.emoji}}</text>
          <text style="margin-left: 6rpx;">{{item.label}}</text>
        </view>
      </view>

      <view class="section-title" style="margin-top: 28rpx;">许个愿</view>
      <textarea
        class="wish-area"
        placeholder="说说你想实现的愿望…"
        placeholder-class="input-ph"
        value="{{newContent}}"
        bindinput="onNewContentInput"
        maxlength="500"
        auto-height
      />

      <view class="row-between" style="margin-top: 16rpx;">
        <view class="text-muted" style="font-size: 24rpx;">期望实现时间（可选）</view>
        <view class="text-gold" style="font-size: 24rpx;" bindtap="onPickExpect">
          {{newExpectText}}
        </view>
      </view>

      <button class="btn-primary submit-btn" bindtap="onSubmit">许下愿望</button>
    </view>

    <!-- 我的愿望 -->
    <view class="section-title" style="margin: 24rpx 32rpx 12rpx;">我的愿望</view>

    <view wx:if="{{loading}}" class="loading text-muted">正在打捞…</view>

    <view wx:elif="{{wishes.length === 0}}" class="empty">
      <view class="empty-icon">🕯</view>
      <view class="empty-title">还没有愿望</view>
      <view class="empty-desc text-muted">许一个，让自己被听到</view>
    </view>

    <view wx:else class="wish-list">
      <view
        wx:for="{{wishes}}"
        wx:key="wishId"
        class="wish-item card"
        data-id="{{item.wishId}}"
      >
        <view class="wish-head">
          <view class="wish-id text-muted">{{item.wishId}}</view>
          <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
        </view>
        <view class="wish-content">{{item.content}}</view>
        <view class="wish-meta text-muted">
          <text>分类：{{item.category === 'study' ? '学业' : item.category === 'career' ? '事业' : item.category === 'love' ? '爱情' : item.category === 'health' ? '健康' : '其他'}}</text>
          <text wx:if="{{item.expectHint}}" style="margin-left: 16rpx;">{{item.expectHint}}</text>
          <text style="margin-left: 16rpx;" class="text-gold">功德 {{item.tapCount || 0}}</text>
        </view>
        <view wx:if="{{item.blessing}}" class="wish-blessing">「{{item.blessing}}」</view>
        <view wx:if="{{item.canClose}}" class="wish-action" data-id="{{item.wishId}}" bindtap="onCloseWish">
          结愿 ›
        </view>
      </view>
    </view>
  </block>

</view>
